# Local RAG server
RAG_HOST=127.0.0.1
RAG_PORT=3000

# Ollama must stay private on the same machine/LAN.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_KEEP_ALIVE=10m

# Only the portfolio and local development origins may call the API from a browser.
RAG_ALLOWED_ORIGINS=https://yunjinyong730.github.io,http://localhost:3000,http://127.0.0.1:3000

# Protect a personal PC from abusive public traffic.
RAG_RATE_LIMIT=10
RAG_RATE_WINDOW_MS=60000
RAG_MAX_CONCURRENT=2
RAG_OLLAMA_TIMEOUT_MS=30000
